name = "f4ah6o/proped-rabbita"

version = "0.24.0"

source = "src"

readme = "README.md"

repository = "https://github.com/f4ah6o/Proped-Rabbita"

license = "Apache-2.0"

keywords = [
  "property-based-testing",
  "model-based-testing",
  "ui",
  "rabbita",
  "moonbit",
]

description = "CLI and library for deterministic property-based Rabbita UI state exploration"

preferred_target = "native"

supported_targets = "+native+js"

import {
  "dowdiness/incr@0.15.0",
  "bobzhang/vg@0.3.0",
  "moonbit-community/rabbita@0.13.1",
  "moonbitlang/async@0.20.2",
  "moonbitlang/x@0.4.46",
}
