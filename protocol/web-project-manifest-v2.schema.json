{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://proped-rabbita.local/schema/web-project-manifest-v2.json",
  "title": "Proped Rabbita Web Project Manifest v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "project",
    "bootstrap",
    "server",
    "browser",
    "discovery",
    "state",
    "normalization",
    "properties",
    "exploration",
    "replay",
    "sandbox",
    "artifacts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root",
        "framework",
        "packageManager"
      ],
      "properties": {
        "root": {
          "type": "string",
          "minLength": 1
        },
        "framework": {
          "type": "string",
          "minLength": 1
        },
        "packageManager": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "bootstrap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install",
        "build"
      ],
      "properties": {
        "install": {
          "$ref": "#/$defs/commandOrNull"
        },
        "build": {
          "$ref": "#/$defs/commandOrNull"
        }
      }
    },
    "server": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "outputDir",
        "start",
        "url",
        "readiness"
      ],
      "properties": {
        "mode": {
          "enum": [
            "static-output",
            "command",
            "external",
            "review-required"
          ]
        },
        "outputDir": {
          "type": [
            "string",
            "null"
          ]
        },
        "start": {
          "$ref": "#/$defs/commandOrNull"
        },
        "url": {
          "type": [
            "string",
            "null"
          ]
        },
        "readiness": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "strategy",
            "timeoutMs"
          ],
          "properties": {
            "strategy": {
              "const": "semantic-quiescence"
            },
            "timeoutMs": {
              "type": "integer",
              "minimum": 1
            }
          }
        }
      }
    },
    "browser": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "engine",
        "headless",
        "viewport",
        "locale",
        "timezone",
        "serviceWorkers"
      ],
      "properties": {
        "engine": {
          "const": "chromium"
        },
        "headless": {
          "type": "boolean"
        },
        "viewport": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "locale": {
          "type": "string",
          "minLength": 1
        },
        "timezone": {
          "type": "string",
          "minLength": 1
        },
        "serviceWorkers": {
          "const": "block"
        }
      }
    },
    "discovery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "actions",
        "selectorPolicy",
        "ambiguity"
      ],
      "properties": {
        "actions": {
          "const": "accessibility"
        },
        "selectorPolicy": {
          "const": "role-first"
        },
        "ambiguity": {
          "const": "fail-closed"
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sources",
        "indexedDB"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "indexedDB": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "mode",
            "adapter"
          ],
          "properties": {
            "mode": {
              "enum": [
                "off",
                "auto-metadata"
              ]
            },
            "adapter": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "kind",
                    "declaredVersion",
                    "resolvedVersion"
                  ],
                  "properties": {
                    "kind": {
                      "const": "dexie"
                    },
                    "declaredVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "resolvedVersion": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "normalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "builtin",
        "volatilityProbeRuns"
      ],
      "properties": {
        "builtin": {
          "type": "boolean"
        },
        "volatilityProbeRuns": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "properties": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packs"
      ],
      "properties": {
        "packs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "exploration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxStates",
        "maxDepth",
        "seed"
      ],
      "properties": {
        "maxStates": {
          "type": "integer",
          "minimum": 1
        },
        "maxDepth": {
          "type": "integer",
          "minimum": 1
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "attempts",
        "freshContext"
      ],
      "properties": {
        "attempts": {
          "type": "integer",
          "minimum": 1
        },
        "freshContext": {
          "const": true
        }
      }
    },
    "sandbox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "executionNetwork",
        "credentials"
      ],
      "properties": {
        "mode": {
          "enum": [
            "strict",
            "caller-enforced"
          ]
        },
        "executionNetwork": {
          "const": "deny"
        },
        "credentials": {
          "const": "deny"
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output",
        "traceOnFailure"
      ],
      "properties": {
        "output": {
          "type": "string",
          "minLength": 1
        },
        "traceOnFailure": {
          "type": "boolean"
        }
      }
    },
    "inference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "generated",
        "confidence",
        "ambiguities"
      ],
      "properties": {
        "generated": {
          "type": "boolean"
        },
        "confidence": {
          "type": "object"
        },
        "ambiguities": {
          "type": "array"
        }
      }
    }
  },
  "$defs": {
    "commandOrNull": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      ]
    }
  }
}
